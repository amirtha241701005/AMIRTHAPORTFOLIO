/* ============================================================
   Amirtha Rengavathi Portfolio — Global Styles
   Migrated from vanilla HTML/CSS to React + Vite
   ============================================================ */


:root {
  --mc-green: #78e06b;
  --mc-emerald: #00d084;
  --mc-cyan: #61f2ff;
  --mc-sky: #84cfff;
  --mc-gold: #ffd56a;
  --mc-lava: #ff7a3d;
  --mc-red: #ff4d67;
  --mc-purple: #b084ff;
  --dark: #05080a;
  --dark2: #091016;
  --dark3: #111b22;
  --ink: #eff8f4;
  --muted: #92a9b5;
  --soft: rgba(239, 248, 244, 0.72);
  --panel: rgba(7, 14, 18, 0.68);
  --panel-strong: rgba(7, 14, 18, 0.86);
  --line: rgba(132, 207, 255, 0.18);
  --line-strong: rgba(97, 242, 255, 0.42);
  --shadow: 0 30px 90px rgba(0, 0, 0, 0.45);
  --ease: cubic-bezier(0.19, 1, 0.22, 1);
  --cursor-fallback: url("data:image/svg+xml,%3Csvg width='64' height='64' viewBox='0 0 64 64' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M8 4h12v8h8v8h8v8h8v8h-8v8h-8v8h-8v-8h-8V32H4V20h4V4Z' fill='%2361f2ff'/%3E%3Cpath d='M20 12h8v8h8v8h8v8h-8v8h-8v8h-8v-8h-8V32H4V20h16v-8Z' fill='%2305080a' fill-opacity='.28'/%3E%3Cpath d='M8 4h12v8h8v8h8v8h8v8h-8v8h-8v8h-8v-8h-8V32H4V20h4V4Z' fill='none' stroke='%23eaffff' stroke-width='4'/%3E%3C/svg%3E");
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  background: var(--dark);
}

body {
  min-height: 100vh;
  font-family: "Rajdhani", system-ui, sans-serif;
  color: var(--ink);
  background:
    radial-gradient(circle at 15% 15%, rgba(120, 224, 107, 0.08), transparent 24rem),
    radial-gradient(circle at 85% 0%, rgba(97, 242, 255, 0.08), transparent 28rem),
    linear-gradient(180deg, #05080a, #091016 45%, #05080a);
  overflow-x: hidden;
  cursor: none;
  letter-spacing: 0;
}

body::after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 9990;
  pointer-events: none;
  background:
    linear-gradient(90deg, rgba(255,255,255,0.025), transparent 28%, rgba(97,242,255,0.018) 50%, transparent 72%, rgba(255,255,255,0.02)),
    repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,255,255,0.018) 3px 4px);
  mix-blend-mode: screen;
  opacity: 0.34;
}

a,
button,
input,
textarea,
.craft-slot,
.filter-btn,
.minimap-dot,
.project-card,
.video-card {
  cursor: none;
}

a {
  color: inherit;
}

button,
input,
textarea {
  font: inherit;
}

button {
  appearance: none;
  border: 0;
  background: none;
  color: inherit;
  text-align: inherit;
}

::selection {
  color: #041014;
  background: var(--mc-cyan);
}

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: #061015;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, var(--mc-cyan), var(--mc-emerald));
  border: 3px solid #061015;
}

#particles {
  position: fixed;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  opacity: 0.52;
}

.cursor-sprite,
.cursor-aura {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 10020;
  pointer-events: none;
  will-change: transform;
}

.cursor-sprite {
  width: 34px;
  height: 34px;
  background-image: var(--cursor-image, var(--cursor-fallback));
  background-size: contain;
  background-repeat: no-repeat;
  image-rendering: pixelated;
  filter: drop-shadow(0 0 10px rgba(97,242,255,0.9));
  transform-origin: 6px 6px;
  transition: filter 180ms var(--ease), scale 180ms var(--ease);
}

.cursor-aura {
  width: 48px;
  height: 48px;
  border: 1px solid rgba(97, 242, 255, 0.34);
  box-shadow: 0 0 26px rgba(97, 242, 255, 0.18), inset 0 0 18px rgba(97, 242, 255, 0.08);
  transform: translate(-50%, -50%);
  transition: width 200ms var(--ease), height 200ms var(--ease), border-color 200ms var(--ease), opacity 200ms var(--ease);
}

body.is-hovering .cursor-sprite {
  scale: 1.2;
  filter: drop-shadow(0 0 18px rgba(120,224,107,0.95));
}

body.is-hovering .cursor-aura {
  width: 68px;
  height: 68px;
  border-color: rgba(120, 224, 107, 0.5);
}

body.is-clicking .cursor-sprite {
  scale: 0.84;
}

.tooltip {
  position: fixed;
  z-index: 10010;
  pointer-events: none;
  opacity: 0;
  padding: 8px 10px;
  color: var(--mc-cyan);
  background: rgba(4, 11, 14, 0.92);
  border: 1px solid rgba(97, 242, 255, 0.35);
  box-shadow: 0 18px 45px rgba(0,0,0,0.35), 0 0 24px rgba(97,242,255,0.1);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
  white-space: nowrap;
  transform: translateY(8px);
  transition: opacity 180ms var(--ease), transform 180ms var(--ease);
}

.tooltip.show {
  opacity: 1;
  transform: translateY(0);
}

#loader {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: grid;
  place-items: center;
  background: linear-gradient(180deg, rgba(4,7,9,0.92) 0%, rgba(4,7,9,0.96) 100%), url("data:image/png;base64,") center/cover no-repeat;
  transition: opacity 800ms var(--ease), visibility 800ms var(--ease);
}

#loader.is-hidden {
  opacity: 0;
  visibility: hidden;
}

.loader-panel {
  width: min(560px, calc(100vw - 36px));
  padding: 34px;
  border: 1px solid rgba(97,242,255,0.24);
  background: linear-gradient(180deg, rgba(8,18,22,0.82), rgba(3,8,10,0.94));
  box-shadow: 0 34px 120px rgba(0,0,0,0.62), inset 0 1px 0 rgba(255,255,255,0.08);
  backdrop-filter: blur(18px);
}

.loader-title {
  font-family: "Press Start 2P", monospace;
  font-size: clamp(10px, 2vw, 14px);
  color: var(--mc-green);
  text-shadow: 0 0 22px rgba(120,224,107,0.8);
  margin-bottom: 22px;
}

.loader-cubes {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 4px;
  margin-bottom: 18px;
}

.loader-cubes span {
  aspect-ratio: 1;
  background: linear-gradient(135deg, #6fc45f, #234322);
  border-top: 2px solid rgba(255,255,255,0.2);
  border-left: 2px solid rgba(255,255,255,0.08);
  animation: cubePulse 900ms var(--ease) infinite alternate;
  animation-delay: calc(var(--i) * 60ms);
}

@keyframes cubePulse {
  to {
    transform: translateY(-8px);
    filter: brightness(1.35);
  }
}

.loader-bar-wrap {
  height: 18px;
  padding: 3px;
  border: 1px solid rgba(120,224,107,0.3);
  background: rgba(255,255,255,0.04);
  overflow: hidden;
}

.loader-bar {
  width: 0%;
  height: 100%;
  background:
    linear-gradient(90deg, rgba(255,255,255,0.2) 0 8px, transparent 8px 12px),
    linear-gradient(90deg, #3fae41, #9cff78, #61f2ff);
  box-shadow: 0 0 22px rgba(120,224,107,0.65);
  transition: width 120ms linear;
}

.loader-status {
  margin-top: 14px;
  color: rgba(239,248,244,0.52);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
  letter-spacing: 1px;
}

nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  padding: 16px clamp(20px, 4vw, 56px);
  background: rgba(4, 10, 12, 0.72);
  border-bottom: 1px solid rgba(97,242,255,0.15);
  backdrop-filter: blur(22px);
  box-shadow: 0 18px 48px rgba(0,0,0,0.24);
}

.nav-logo,
.footer-logo {
  font-family: "Press Start 2P", monospace;
  font-size: 10px;
  color: var(--mc-cyan);
  letter-spacing: 2px;
  text-shadow: 0 0 18px rgba(97,242,255,0.52);
}

.nav-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(14px, 2vw, 30px);
  list-style: none;
}

.nav-links a {
  position: relative;
  display: inline-flex;
  padding: 8px 0;
  color: rgba(239,248,244,0.62);
  text-decoration: none;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  transition: color 220ms var(--ease);
}

.nav-links a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 2px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--mc-cyan), transparent);
  transform: scaleX(0);
  transition: transform 260ms var(--ease);
}

.nav-links a:hover,
.nav-links a:focus-visible {
  color: var(--mc-cyan);
}

.nav-links a:hover::after,
.nav-links a:focus-visible::after {
  transform: scaleX(1);
}

.nav-status {
  display: flex;
  align-items: center;
  gap: 9px;
  color: rgba(120,224,107,0.82);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
  letter-spacing: 1px;
}

.status-dot {
  width: 9px;
  height: 9px;
  background: var(--mc-green);
  box-shadow: 0 0 16px rgba(120,224,107,0.86);
  animation: pulse 1700ms ease-in-out infinite;
}

@keyframes pulse {
  50% {
    transform: scale(0.72);
    opacity: 0.55;
  }
}

section {
  position: relative;
  z-index: 3;
  min-height: 80vh;
  padding: clamp(92px, 12vw, 150px) 0;
  isolation: isolate;
}

.section-container {
  width: min(1200px, calc(100vw - 40px));
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.section-kicker,
.section-label {
  font-family: "Press Start 2P", monospace;
  font-size: 8px;
  letter-spacing: 2px;
  color: var(--mc-green);
  text-transform: uppercase;
  margin-bottom: 13px;
}

.section-title {
  max-width: 850px;
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: clamp(32px, 5vw, 62px);
  line-height: 1.02;
  letter-spacing: 0;
  color: #fff;
  text-shadow: 0 0 36px rgba(97,242,255,0.12);
  margin-bottom: 18px;
}

.section-title .accent {
  color: var(--mc-cyan);
}

.section-divider {
  width: min(220px, 38vw);
  height: 3px;
  margin-bottom: clamp(34px, 6vw, 64px);
  background: linear-gradient(90deg, var(--mc-cyan), var(--mc-emerald), transparent);
  box-shadow: 0 0 22px rgba(97,242,255,0.35);
}

.ambient-section::before,
#hero .hero-bg {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -3;
  background-position: center;
  background-size: cover;
  transform: translateY(calc(var(--parallax, 0) * 1px)) scale(1.05);
  will-change: transform;
}

.ambient-section::before { background-image: linear-gradient(180deg, rgba(5,10,14,0.82) 0%, rgba(5,10,14,0.93) 100%), url("data:image/png;base64,") center/cover no-repeat; filter: blur(8px) saturate(0.96); }base64,") center/cover no-repeat;
  filter: blur(8px) saturate(0.96);
}

.ambient-section::after,
#hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  pointer-events: none;
  background:
    radial-gradient(circle at 16% 18%, rgba(255,213,106,0.18), transparent 20rem),
    radial-gradient(circle at 82% 18%, rgba(97,242,255,0.12), transparent 18rem),
    linear-gradient(180deg, rgba(3,6,8,0.6), rgba(3,6,8,0.86) 45%, rgba(3,6,8,0.92));
}

#hero {
  min-height: 100vh;
  display: grid;
  align-items: center;
  overflow: hidden;
  padding-top: 90px;
}

#hero .hero-bg {
  background-image:
    linear-gradient(180deg, rgba(3,8,10,0.52) 0%, rgba(3,8,10,0.78) 100%), url("data:image/png;base64,") center/cover no-repeat;
  animation: heroDrift 18s var(--ease) infinite alternate;
  filter: saturate(0.98) contrast(1.04);
}

@keyframes heroDrift {
  to {
    transform: translateY(calc(var(--parallax, 0) * 1px - 12px)) scale(1.1);
  }
}

.hero-depth,
.hero-fog,
.hero-beams,
.hero-voxel-floor,
.floating-items {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hero-depth {
  z-index: -1;
  background:
    radial-gradient(ellipse at 50% 12%, rgba(255,255,255,0.16), transparent 18rem),
    linear-gradient(90deg, rgba(0,0,0,0.72), transparent 26%, transparent 70%, rgba(0,0,0,0.65)),
    linear-gradient(180deg, rgba(0,0,0,0.32), rgba(0,0,0,0.62) 58%, #05080a 100%);
}

.hero-beams {
  z-index: 0;
  background:
    conic-gradient(from 210deg at 48% -10%, transparent 0 20deg, rgba(132,207,255,0.15) 28deg, transparent 42deg 95deg, rgba(255,213,106,0.1) 108deg, transparent 124deg 360deg);
  mix-blend-mode: screen;
  opacity: 0.7;
  animation: beamSweep 12s ease-in-out infinite alternate;
}

@keyframes beamSweep {
  to {
    transform: translateX(4vw) rotate(3deg);
    opacity: 0.92;
  }
}

.hero-fog {
  z-index: 1;
  top: auto;
  height: 44%;
  background:
    radial-gradient(ellipse at 25% 88%, rgba(120,224,107,0.2), transparent 24rem),
    radial-gradient(ellipse at 78% 85%, rgba(97,242,255,0.16), transparent 22rem),
    linear-gradient(180deg, transparent, rgba(5,8,10,0.86));
  filter: blur(12px);
  animation: fogMove 9s ease-in-out infinite alternate;
}

@keyframes fogMove {
  to {
    transform: translateX(-3vw) translateY(8px);
  }
}

.hero-voxel-floor {
  top: auto;
  bottom: -1px;
  height: 130px;
  z-index: 2;
  background:
    linear-gradient(135deg, rgba(255,255,255,0.12) 0 7px, transparent 7px 32px),
    linear-gradient(90deg, rgba(120,224,107,0.36), rgba(51,89,55,0.48) 42%, rgba(23,36,31,0.86)),
    repeating-linear-gradient(90deg, rgba(255,255,255,0.06) 0 1px, transparent 1px 64px),
    repeating-linear-gradient(0deg, rgba(0,0,0,0.16) 0 1px, transparent 1px 32px);
  border-top: 1px solid rgba(120,224,107,0.28);
  box-shadow: 0 -24px 80px rgba(120,224,107,0.13);
}

.floating-items {
  z-index: 1;
}

.float-item {
  position: absolute;
  width: var(--size, 44px);
  height: var(--size, 44px);
  border: 1px solid rgba(97,242,255,0.22);
  background:
    linear-gradient(135deg, rgba(255,255,255,0.12), rgba(255,255,255,0.02)),
    radial-gradient(circle at 28% 24%, var(--glow, rgba(97,242,255,0.28)), transparent 56%);
  box-shadow: 0 0 28px var(--glow, rgba(97,242,255,0.18)), inset 0 0 18px rgba(255,255,255,0.05);
  transform: rotate(var(--rot, 0deg));
  animation: floatItem var(--fi, 7s) var(--delay, 0s) ease-in-out infinite;
  opacity: 0.78;
}

.float-item::before,
.float-item::after {
  content: "";
  position: absolute;
  inset: 25%;
  border: 1px solid currentColor;
  color: rgba(255,255,255,0.48);
}

.float-item::after {
  inset: 42%;
  background: currentColor;
}

@keyframes floatItem {
  50% {
    transform: translateY(-22px) rotate(calc(var(--rot, 0deg) + 7deg));
  }
}

.hero-content {
  width: min(1200px, calc(100vw - 40px));
  margin: 0 auto;
  position: relative;
  z-index: 5;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 330px;
  gap: clamp(32px, 6vw, 72px);
  align-items: center;
}

.hero-copy {
  max-width: 850px;
}

.hero-badge,
.glass-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 9px 14px;
  border: 1px solid rgba(97,242,255,0.24);
  background: rgba(5, 14, 18, 0.58);
  color: var(--mc-cyan);
  box-shadow: 0 0 30px rgba(97,242,255,0.08), inset 0 1px 0 rgba(255,255,255,0.08);
  backdrop-filter: blur(14px);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
  letter-spacing: 1.4px;
  text-transform: uppercase;
}

.hero-name {
  margin: 22px 0 8px;
  color: rgba(239,248,244,0.82);
  font-size: clamp(18px, 2.6vw, 26px);
  font-weight: 600;
  letter-spacing: 1px;
}

.hero-title {
  max-width: 880px;
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: clamp(46px, 8vw, 98px);
  line-height: 0.98;
  letter-spacing: 0;
  color: #fff;
  text-shadow:
    0 0 22px rgba(97,242,255,0.16),
    0 20px 80px rgba(0,0,0,0.55);
}

.hero-title span {
  color: var(--mc-cyan);
  text-shadow: 0 0 38px rgba(97,242,255,0.46);
}

.hero-sub {
  max-width: 700px;
  margin-top: 26px;
  color: rgba(239,248,244,0.78);
  font-size: clamp(18px, 2vw, 22px);
  line-height: 1.55;
}

.hero-role {
  margin-top: 18px;
  color: var(--mc-green);
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 1.6px;
  text-transform: uppercase;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 36px;
}

.hero-btn,
.resume-btn,
.form-submit {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 48px;
  padding: 14px 24px;
  color: #041014;
  background: linear-gradient(135deg, var(--mc-cyan), var(--mc-green));
  border: 1px solid rgba(255,255,255,0.24);
  box-shadow: 0 0 28px rgba(97,242,255,0.24), inset 0 1px 0 rgba(255,255,255,0.32);
  text-decoration: none;
  overflow: hidden;
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 1.7px;
  text-transform: uppercase;
  transition: transform 220ms var(--ease), box-shadow 220ms var(--ease), color 220ms var(--ease), border-color 220ms var(--ease);
}

.hero-btn.secondary,
.resume-btn {
  color: var(--mc-gold);
  background: rgba(255,213,106,0.07);
  border-color: rgba(255,213,106,0.42);
  box-shadow: 0 0 28px rgba(255,213,106,0.12), inset 0 1px 0 rgba(255,255,255,0.1);
}

.hero-btn::before,
.resume-btn::before,
.form-submit::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.38), transparent);
  transform: translateX(-120%);
  transition: transform 520ms var(--ease);
}

.hero-btn:hover,
.hero-btn:focus-visible,
.resume-btn:hover,
.resume-btn:focus-visible,
.form-submit:hover,
.form-submit:focus-visible {
  transform: translateY(-3px);
  box-shadow: 0 18px 46px rgba(97,242,255,0.2);
}

.hero-btn:hover::before,
.hero-btn:focus-visible::before,
.resume-btn:hover::before,
.resume-btn:focus-visible::before,
.form-submit:hover::before,
.form-submit:focus-visible::before {
  transform: translateX(120%);
}

.button-icon {
  width: 17px;
  height: 17px;
  display: inline-block;
}

.button-icon svg {
  width: 100%;
  height: 100%;
  display: block;
}

.hud-panel {
  position: relative;
  padding: 22px;
  background: linear-gradient(180deg, rgba(6,16,20,0.72), rgba(4,10,13,0.88));
  border: 1px solid rgba(97,242,255,0.23);
  box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,0.08);
  backdrop-filter: blur(18px);
}

.hud-panel::before,
.hud-panel::after,
.project-card::before,
.lab-panel::before,
.video-card::before,
.contact-form::before {
  content: "";
  position: absolute;
  width: 18px;
  height: 18px;
  pointer-events: none;
}

.hud-panel::before,
.project-card::before,
.lab-panel::before,
.video-card::before,
.contact-form::before {
  left: 10px;
  top: 10px;
  border-left: 2px solid rgba(97,242,255,0.5);
  border-top: 2px solid rgba(97,242,255,0.5);
}

.hud-panel::after,
.project-card::after,
.lab-panel::after,
.video-card::after,
.contact-form::after {
  right: 10px;
  bottom: 10px;
  border-right: 2px solid rgba(120,224,107,0.44);
  border-bottom: 2px solid rgba(120,224,107,0.44);
}

.hud-title {
  color: var(--mc-cyan);
  font-family: "Press Start 2P", monospace;
  font-size: 8px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-bottom: 18px;
}



@keyframes hudScan {
  to {
    transform: translateY(30px);
  }
}

.hud-stat {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 9px 0;
  border-bottom: 1px solid rgba(255,255,255,0.07);
  color: rgba(239,248,244,0.72);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.hud-stat strong {
  color: var(--ink);
  font-weight: 700;
  text-align: right;
}

.inventory-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 7px;
  margin-top: 18px;
}

.inventory-slot {
  aspect-ratio: 1;
  border: 1px solid rgba(97,242,255,0.22);
  background:
    linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02)),
    rgba(5,12,15,0.72);
  box-shadow: inset 0 0 18px rgba(97,242,255,0.05);
  position: relative;
  overflow: hidden;
}

.inventory-slot::before {
  content: "";
  position: absolute;
  inset: 30%;
  background: var(--slot, var(--mc-cyan));
  box-shadow: 0 0 22px var(--slot, var(--mc-cyan));
}

.xp-bar-wrap {
  margin-top: 22px;
}

.xp-label {
  display: flex;
  justify-content: space-between;
  margin-bottom: 7px;
  color: var(--mc-green);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
  letter-spacing: 1px;
  text-shadow: 0 0 10px rgba(120,224,107,0.54);
}

.xp-bar {
  height: 12px;
  padding: 2px;
  border: 1px solid rgba(120,224,107,0.32);
  background: rgba(255,255,255,0.04);
  overflow: hidden;
}

.xp-fill {
  width: 0%;
  height: 100%;
  background:
    linear-gradient(90deg, rgba(255,255,255,0.22) 0 8px, transparent 8px 12px),
    linear-gradient(90deg, #40b83f, #a4ff7c, #61f2ff);
  box-shadow: 0 0 20px rgba(120,224,107,0.7);
  animation: xpFill 2.4s 900ms var(--ease) forwards;
}

@keyframes xpFill {
  to {
    width: 84%;
  }
}

.about-grid,
.contact-grid,
.achievement-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
  gap: clamp(32px, 6vw, 72px);
  align-items: start;
}

.glass-panel,
.crafting-wrap,
.contact-form,
.contact-info,
.achievement-panel {
  position: relative;
  padding: clamp(24px, 4vw, 34px);
  background: linear-gradient(180deg, rgba(6,16,20,0.72), rgba(6,12,15,0.88));
  border: 1px solid rgba(97,242,255,0.17);
  box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,0.08);
  backdrop-filter: blur(18px);
}

.about-bio {
  color: rgba(239,248,244,0.78);
  font-size: clamp(17px, 1.6vw, 20px);
  line-height: 1.72;
}

.about-bio p + p {
  margin-top: 18px;
}

.highlight {
  color: var(--mc-cyan);
  font-weight: 700;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-top: 26px;
}

.meta-card {
  padding: 14px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
}

.meta-card small {
  display: block;
  margin-bottom: 6px;
  color: var(--mc-green);
  font-family: "Press Start 2P", monospace;
  font-size: 6px;
  letter-spacing: 1px;
}

.meta-card strong {
  display: block;
  color: var(--ink);
  font-size: 16px;
  line-height: 1.3;
}

.skills-section {
  margin-top: 28px;
}

.skill-row {
  margin-bottom: 16px;
}

.skill-info {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 7px;
}

.skill-name {
  color: rgba(239,248,244,0.82);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.skill-level {
  color: var(--mc-green);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
}

.skill-bar {
  height: 9px;
  padding: 2px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  overflow: hidden;
}

.skill-fill {
  width: 0%;
  height: 100%;
  background: linear-gradient(90deg, var(--sc), var(--sc2));
  box-shadow: 0 0 18px var(--sc);
  transition: width 1.4s var(--ease);
}

.skill-fill.animated {
  width: var(--sw);
}

.crafting-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  color: var(--mc-gold);
  font-family: "Press Start 2P", monospace;
  font-size: 8px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.crafting-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.craft-slot {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 112px;
  padding: 14px 8px;
  overflow: hidden;
  color: var(--slot-color);
  background:
    linear-gradient(135deg, rgba(255,255,255,0.09), rgba(255,255,255,0.018)),
    rgba(5,12,16,0.78);
  border: 1px solid rgba(255,255,255,0.08);
  box-shadow: inset 0 0 22px rgba(255,255,255,0.025);
  transition: transform 260ms var(--ease), border-color 260ms var(--ease), box-shadow 260ms var(--ease);
}

.craft-slot::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 25%, currentColor, transparent 58%);
  opacity: 0;
  transition: opacity 260ms var(--ease);
}

.craft-slot:hover,
.craft-slot:focus-visible {
  transform: translateY(-6px);
  border-color: currentColor;
  box-shadow: 0 18px 42px rgba(0,0,0,0.34), 0 0 28px color-mix(in srgb, currentColor 28%, transparent);
}

.craft-slot:hover::before,
.craft-slot:focus-visible::before {
  opacity: 0.12;
}

.slot-icon {
  width: 38px;
  height: 38px;
  display: block;
  margin-bottom: 9px;
  filter: drop-shadow(0 0 12px currentColor);
}

.slot-icon svg {
  width: 100%;
  height: 100%;
  display: block;
}

.slot-label {
  color: rgba(239,248,244,0.72);
  font-family: "Press Start 2P", monospace;
  font-size: 6px;
  letter-spacing: 0.7px;
  text-align: center;
  line-height: 1.5;
}

.crafted-result {
  display: grid;
  grid-template-columns: 56px 1fr;
  gap: 14px;
  align-items: center;
  margin-top: 18px;
  padding-top: 18px;
  border-top: 1px solid rgba(255,255,255,0.08);
}

.crafted-result > div:last-child {
  min-width: 0;
}

.crafted-cube {
  width: 56px;
  height: 56px;
  background:
    linear-gradient(135deg, rgba(255,255,255,0.28), transparent 20%),
    linear-gradient(135deg, var(--mc-cyan), var(--mc-emerald));
  box-shadow: 0 0 28px rgba(97,242,255,0.38), inset -8px -8px 0 rgba(0,0,0,0.18);
}

.crafted-result small {
  display: block;
  color: var(--mc-cyan);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
  letter-spacing: 1px;
  margin-bottom: 6px;
}

.crafted-result strong {
  display: block;
  color: #fff;
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: 17px;
  line-height: 1.25;
  letter-spacing: 1px;
  overflow-wrap: anywhere;
}

#projects {
  overflow: hidden;
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 34px;
}

.filter-btn {
  min-height: 40px;
  padding: 10px 16px;
  color: rgba(239,248,244,0.66);
  background: rgba(5,14,18,0.68);
  border: 1px solid rgba(255,255,255,0.1);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1.3px;
  text-transform: uppercase;
  transition: transform 220ms var(--ease), color 220ms var(--ease), border-color 220ms var(--ease), background 220ms var(--ease);
}

.filter-btn:hover,
.filter-btn:focus-visible,
.filter-btn.active {
  color: var(--mc-cyan);
  background: rgba(97,242,255,0.08);
  border-color: rgba(97,242,255,0.45);
  transform: translateY(-2px);
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
  perspective: 1200px;
}

.project-card {
  position: relative;
  min-height: 0;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(9,20,26,0.82), rgba(4,9,12,0.94));
  border: 1px solid rgba(255,255,255,0.1);
  box-shadow: 0 22px 70px rgba(0,0,0,0.34);
  transform-style: preserve-3d;
  transition: transform 260ms var(--ease), border-color 260ms var(--ease), box-shadow 260ms var(--ease), opacity 260ms var(--ease);
}

.project-card:hover,
.project-card:focus-within {
  border-color: rgba(97,242,255,0.46);
  box-shadow: 0 36px 100px rgba(0,0,0,0.52), 0 0 36px rgba(97,242,255,0.12);
}

.project-thumb {
  height: clamp(270px, 34vw, 380px);
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 10%, color-mix(in srgb, var(--badge), white 20%), transparent 13rem),
    linear-gradient(145deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02)),
    #071017;
}

.project-thumb.has-image::before {
  content: "";
  position: absolute;
  inset: -18px;
  background-image: var(--thumb);
  background-size: cover;
  background-position: center;
  filter: blur(18px) brightness(0.42) saturate(1.15);
  transform: scale(1.08);
  opacity: 0.78;
}

.project-image {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
  object-position: center;
  padding: 12px;
  filter: saturate(0.96) contrast(1.04);
  transition: transform 420ms var(--ease), filter 420ms var(--ease);
}

.project-card:hover .project-image,
.project-card:focus-within .project-image {
  transform: scale(1.035);
  filter: saturate(1.06) contrast(1.08);
}

.project-scene {
  position: absolute;
  inset: 0;
}

.project-scene::before {
  content: "";
  position: absolute;
  inset: 18px 18px 38px;
  background:
    linear-gradient(135deg, rgba(255,255,255,0.16), transparent 20%),
    linear-gradient(180deg, color-mix(in srgb, var(--badge), transparent 55%), rgba(0,0,0,0.12));
  clip-path: polygon(14% 12%, 78% 0, 94% 38%, 78% 78%, 24% 96%, 4% 54%);
  filter: drop-shadow(0 18px 36px color-mix(in srgb, var(--badge), transparent 62%));
  transform: translateZ(38px);
}

.project-scene::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 82px;
  background:
    repeating-linear-gradient(90deg, rgba(255,255,255,0.08) 0 1px, transparent 1px 42px),
    repeating-linear-gradient(0deg, rgba(0,0,0,0.16) 0 1px, transparent 1px 26px),
    linear-gradient(90deg, rgba(120,224,107,0.32), rgba(97,242,255,0.16), rgba(255,213,106,0.14));
  transform: skewY(-2deg);
  transform-origin: bottom;
}

.project-light {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(115deg, transparent 18%, rgba(255,255,255,0.2), transparent 48%),
    radial-gradient(circle at 70% 20%, rgba(255,255,255,0.16), transparent 10rem);
  opacity: 0;
  transform: translateX(-28%);
  transition: opacity 260ms var(--ease), transform 520ms var(--ease);
}

.project-card:hover .project-light {
  opacity: 1;
  transform: translateX(16%);
}

.project-type-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  z-index: 2;
  padding: 7px 10px;
  color: var(--badge);
  background: rgba(3,9,12,0.72);
  border: 1px solid color-mix(in srgb, var(--badge), transparent 55%);
  backdrop-filter: blur(12px);
  font-family: "Press Start 2P", monospace;
  font-size: 6px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.project-body {
  padding: 22px;
}

.project-name {
  margin-bottom: 9px;
  color: #fff;
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: 18px;
  font-weight: 800;
}

.project-desc {
  min-height: 86px;
  color: rgba(239,248,244,0.65);
  font-size: 15px;
  line-height: 1.55;
}

.project-tools {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 18px;
}

.project-open {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  margin-top: 18px;
  color: var(--badge);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
  letter-spacing: 1px;
  text-decoration: none;
  text-transform: uppercase;
}

.project-open:hover,
.project-open:focus-visible {
  color: var(--mc-cyan);
}

.tool-tag {
  padding: 5px 9px;
  color: rgba(239,248,244,0.72);
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.8px;
}

.project-hover-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--badge), var(--mc-cyan));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 360ms var(--ease);
}

.project-card:hover .project-hover-bar {
  transform: scaleX(1);
}

#casestudy {
  background:
    radial-gradient(circle at 50% 0%, rgba(97,242,255,0.09), transparent 28rem),
    linear-gradient(180deg, #060b0f, #08151b 50%, #05080a);
  overflow: hidden;
}

#casestudy::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(90deg, rgba(97,242,255,0.04) 1px, transparent 1px),
    linear-gradient(0deg, rgba(97,242,255,0.04) 1px, transparent 1px);
  background-size: 54px 54px;
  mask-image: radial-gradient(circle at 50% 28%, black, transparent 70%);
}

.case-intro {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
  gap: clamp(28px, 5vw, 60px);
  align-items: center;
  margin-bottom: 42px;
}

.case-intro h3 {
  color: #fff;
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: clamp(22px, 3vw, 36px);
  line-height: 1.15;
  margin-bottom: 14px;
}

.case-intro p {
  color: rgba(239,248,244,0.68);
  font-size: 17px;
  line-height: 1.6;
}

.hologram-screen {
  position: relative;
  min-height: 280px;
  border: 1px solid rgba(97,242,255,0.26);
  background:
    radial-gradient(circle at 50% 50%, rgba(97,242,255,0.18), transparent 11rem),
    linear-gradient(180deg, rgba(7,22,28,0.52), rgba(2,8,10,0.84));
  box-shadow: inset 0 0 70px rgba(97,242,255,0.08), 0 28px 90px rgba(0,0,0,0.34);
  overflow: hidden;
}

.hologram-screen::before {
  content: "";
  position: absolute;
  inset: 34px;
  border: 1px solid rgba(97,242,255,0.22);
  background:
    linear-gradient(90deg, transparent 0 28%, rgba(97,242,255,0.16) 28% 29%, transparent 29% 100%),
    linear-gradient(0deg, transparent 0 32%, rgba(120,224,107,0.14) 32% 33%, transparent 33% 100%);
  animation: hologramFloat 4s ease-in-out infinite alternate;
}

.hologram-screen::after {
  content: "";
  position: absolute;
  left: 14%;
  right: 14%;
  top: 42%;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--mc-cyan), var(--mc-green), transparent);
  box-shadow: 0 0 22px rgba(97,242,255,0.55);
  animation: flowLine 2.4s linear infinite;
}

@keyframes hologramFloat {
  to {
    transform: translateY(-10px);
    box-shadow: 0 0 38px rgba(97,242,255,0.16);
  }
}

@keyframes flowLine {
  50% {
    transform: translateY(46px);
  }
}

.lab-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.lab-panel {
  position: relative;
  min-height: 290px;
  padding: 24px;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(7,18,23,0.82), rgba(4,9,12,0.96));
  border: 1px solid rgba(97,242,255,0.14);
  box-shadow: 0 22px 70px rgba(0,0,0,0.34);
}

.lab-panel[data-step]::marker {
  content: "";
}

.lab-number {
  position: absolute;
  right: 20px;
  top: 16px;
  color: rgba(97,242,255,0.08);
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: 56px;
  font-weight: 900;
}

.lab-step {
  color: var(--mc-cyan);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
  letter-spacing: 1.3px;
  margin-bottom: 16px;
}

.lab-heading {
  margin-bottom: 10px;
  color: #fff;
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: 18px;
  font-weight: 800;
}

.lab-text {
  color: rgba(239,248,244,0.65);
  font-size: 15px;
  line-height: 1.58;
}

.wireframe-preview {
  position: relative;
  height: 98px;
  margin-top: 18px;
  overflow: hidden;
  border: 1px dashed rgba(97,242,255,0.26);
  background: rgba(97,242,255,0.035);
}

.wireframe-preview svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.wireframe-preview .flow-dot {
  position: absolute;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--mc-green);
  box-shadow: 0 0 14px var(--mc-green);
  offset-path: path("M 18 72 C 84 8, 142 94, 228 24");
  animation: dotFlow 2.8s linear infinite;
}

@keyframes dotFlow {
  to {
    offset-distance: 100%;
  }
}

#video {
  min-height: 90vh;
  background:
    radial-gradient(circle at 50% 42%, rgba(176,132,255,0.18), transparent 18rem),
    radial-gradient(circle at 50% 56%, rgba(255,77,103,0.12), transparent 22rem),
    linear-gradient(180deg, #05080a, #100817 50%, #05080a);
  overflow: hidden;
}

.portal-ring {
  position: absolute;
  top: 54%;
  left: 50%;
  width: min(760px, 86vw);
  aspect-ratio: 1.28;
  transform: translate(-50%, -50%);
  border: 20px solid rgba(176,132,255,0.18);
  box-shadow:
    0 0 70px rgba(176,132,255,0.18),
    inset 0 0 90px rgba(255,77,103,0.14);
  filter: blur(0.2px);
  opacity: 0.7;
  pointer-events: none;
}

.portal-ring::before {
  content: "";
  position: absolute;
  inset: 22px;
  background:
    radial-gradient(circle at 35% 35%, rgba(255,255,255,0.18), transparent 10rem),
    conic-gradient(from 180deg, rgba(176,132,255,0.28), rgba(255,77,103,0.22), rgba(97,242,255,0.12), rgba(176,132,255,0.28));
  filter: blur(12px);
  animation: portalSpin 9s linear infinite;
}

@keyframes portalSpin {
  to {
    transform: rotate(360deg);
  }
}

.video-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.video-card {
  position: relative;
  overflow: hidden;
  min-height: 348px;
  background: linear-gradient(180deg, rgba(13,10,20,0.82), rgba(5,8,10,0.95));
  border: 1px solid rgba(176,132,255,0.18);
  box-shadow: 0 22px 70px rgba(0,0,0,0.42);
  transition: transform 260ms var(--ease), border-color 260ms var(--ease), box-shadow 260ms var(--ease);
}

.video-card:hover,
.video-card:focus-within {
  transform: translateY(-8px);
  border-color: rgba(176,132,255,0.52);
  box-shadow: 0 38px 110px rgba(0,0,0,0.52), 0 0 34px rgba(176,132,255,0.2);
}

.video-thumb {
  position: relative;
  height: 192px;
  overflow: hidden;
  background:
    linear-gradient(135deg, color-mix(in srgb, var(--accent), transparent 30%), rgba(5,8,10,0.45)),
    #0a0810;
}

.preview-frame {
  position: absolute;
  inset: 18px;
  border: 1px solid rgba(255,255,255,0.16);
  background:
    repeating-linear-gradient(90deg, rgba(255,255,255,0.08) 0 4px, transparent 4px 12px),
    radial-gradient(circle at 48% 48%, rgba(255,255,255,0.16), transparent 4rem),
    linear-gradient(140deg, rgba(255,255,255,0.08), transparent);
  clip-path: polygon(0 0, 100% 0, 86% 100%, 0 82%);
  filter: saturate(1.1);
}

.video-card:hover .preview-frame {
  animation: glitchShift 540ms steps(2, end) infinite;
}

@keyframes glitchShift {
  33% {
    transform: translateX(5px);
    filter: hue-rotate(30deg);
  }
  66% {
    transform: translateX(-4px);
    filter: hue-rotate(-35deg);
  }
}

.play-btn {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 58px;
  height: 58px;
  transform: translate(-50%, -50%);
  border: 1px solid rgba(255,255,255,0.4);
  background: rgba(5,8,10,0.62);
  box-shadow: 0 0 24px color-mix(in srgb, var(--accent), transparent 44%);
  backdrop-filter: blur(12px);
}

.play-btn::before {
  content: "";
  position: absolute;
  left: 22px;
  top: 17px;
  border-left: 18px solid #fff;
  border-top: 12px solid transparent;
  border-bottom: 12px solid transparent;
}

.video-info {
  padding: 20px;
}

.video-title {
  color: #fff;
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: 17px;
  font-weight: 800;
  margin-bottom: 8px;
}

.video-meta {
  color: color-mix(in srgb, var(--accent), white 20%);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.timeline-bar {
  height: 6px;
  margin-top: 18px;
  padding: 1px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.08);
}

.timeline-progress {
  width: var(--tw);
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--mc-cyan));
  box-shadow: 0 0 18px var(--accent);
}

#achievements {
  background:
    radial-gradient(circle at 15% 18%, rgba(255,213,106,0.08), transparent 24rem),
    radial-gradient(circle at 90% 10%, rgba(97,242,255,0.08), transparent 24rem),
    linear-gradient(180deg, #05080a, #0a1114 50%, #05080a);
}

.achievements-timeline {
  position: relative;
  padding-left: 34px;
}

.achievements-timeline::before {
  content: "";
  position: absolute;
  left: 9px;
  top: 4px;
  bottom: 4px;
  width: 2px;
  background: linear-gradient(180deg, var(--mc-gold), var(--mc-cyan), var(--mc-emerald), transparent);
  box-shadow: 0 0 18px rgba(97,242,255,0.24);
}

.achievement-item {
  position: relative;
  margin-bottom: 28px;
  padding: 22px;
  background: rgba(255,255,255,0.035);
  border: 1px solid rgba(255,255,255,0.08);
  transition: transform 260ms var(--ease), border-color 260ms var(--ease), background 260ms var(--ease);
}

.achievement-item:hover {
  transform: translateX(6px);
  border-color: var(--dot-color);
  background: rgba(255,255,255,0.055);
}

.achievement-dot {
  position: absolute;
  left: -34px;
  top: 22px;
  width: 20px;
  height: 20px;
  background: var(--dot-color);
  box-shadow: 0 0 20px var(--dot-color);
}

.achievement-dot::after {
  content: "";
  position: absolute;
  inset: 6px;
  background: #05080a;
}

.achievement-date {
  color: var(--mc-gold);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
  letter-spacing: 1px;
  margin-bottom: 10px;
}

.achievement-title {
  color: #fff;
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: 19px;
  font-weight: 800;
  margin-bottom: 6px;
}

.achievement-company {
  color: var(--dot-color);
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.achievement-desc {
  color: rgba(239,248,244,0.66);
  font-size: 15px;
  line-height: 1.55;
}

.achievement-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 14px;
}

.badge {
  padding: 5px 9px;
  color: var(--bc);
  border: 1px solid color-mix(in srgb, var(--bc), transparent 58%);
  background: color-mix(in srgb, var(--bc), transparent 92%);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.9px;
  text-transform: uppercase;
}

.achievement-panel {
  border-color: rgba(255,213,106,0.2);
}

.achievement-list {
  display: grid;
  gap: 12px;
}

.unlock-card {
  display: grid;
  grid-template-columns: 46px 1fr;
  gap: 14px;
  align-items: center;
  padding: 13px;
  background: rgba(255,255,255,0.035);
  border: 1px solid rgba(255,213,106,0.12);
  transition: transform 240ms var(--ease), border-color 240ms var(--ease);
}

.unlock-card:hover {
  transform: translateY(-4px);
  border-color: rgba(255,213,106,0.42);
}

.unlock-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  color: var(--mc-gold);
  background: rgba(255,213,106,0.08);
  border: 1px solid rgba(255,213,106,0.26);
}

.unlock-icon svg {
  width: 25px;
  height: 25px;
}

.unlock-title {
  color: #fff;
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: 14px;
  font-weight: 800;
}

.unlock-sub {
  margin-top: 2px;
  color: rgba(239,248,244,0.52);
  font-size: 13px;
}

#contact {
  overflow: hidden;
}

.portal-bg {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(640px, 90vw);
  aspect-ratio: 1;
  transform: translate(-50%, -50%);
  pointer-events: none;
  border: 1px solid rgba(97,242,255,0.18);
  background:
    radial-gradient(circle at center, rgba(97,242,255,0.24), transparent 18%),
    conic-gradient(from 0deg, rgba(97,242,255,0.06), rgba(120,224,107,0.18), rgba(255,213,106,0.08), rgba(97,242,255,0.06));
  box-shadow: 0 0 90px rgba(97,242,255,0.16), inset 0 0 80px rgba(120,224,107,0.08);
  filter: blur(0.2px);
  animation: contactPortal 7s linear infinite;
  opacity: 0.72;
}

@keyframes contactPortal {
  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

.contact-info h3 {
  color: #fff;
  font-family: "Orbitron", system-ui, sans-serif;
  font-size: clamp(24px, 3vw, 36px);
  line-height: 1.14;
  margin-bottom: 16px;
}

.contact-info p {
  color: rgba(239,248,244,0.7);
  font-size: 17px;
  line-height: 1.65;
  margin-bottom: 24px;
}

.social-links {
  display: grid;
  gap: 12px;
}

.social-link {
  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 14px;
  align-items: center;
  padding: 13px;
  text-decoration: none;
  color: rgba(239,248,244,0.74);
  background: rgba(255,255,255,0.035);
  border: 1px solid rgba(255,255,255,0.08);
  transition: transform 240ms var(--ease), border-color 240ms var(--ease), color 240ms var(--ease);
}

.social-link:hover,
.social-link:focus-visible {
  transform: translateX(8px);
  border-color: var(--sl-color);
  color: #fff;
}

.social-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  color: var(--sl-color);
  background: color-mix(in srgb, var(--sl-color), transparent 90%);
  border: 1px solid color-mix(in srgb, var(--sl-color), transparent 62%);
}

.social-icon svg {
  width: 22px;
  height: 22px;
}

.social-label {
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.social-sub {
  margin-top: 2px;
  color: rgba(239,248,244,0.48);
  font-size: 13px;
  letter-spacing: 0.2px;
}

.contact-form {
  display: grid;
  gap: 16px;
}

.form-group {
  display: grid;
  gap: 8px;
}

.form-label {
  color: var(--mc-green);
  font-family: "Press Start 2P", monospace;
  font-size: 7px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.form-input,
.form-textarea {
  width: 100%;
  color: var(--ink);
  background: rgba(255,255,255,0.045);
  border: 1px solid rgba(255,255,255,0.1);
  outline: 0;
  padding: 15px 16px;
  transition: border-color 220ms var(--ease), box-shadow 220ms var(--ease), background 220ms var(--ease);
}

.form-input::placeholder,
.form-textarea::placeholder {
  color: rgba(239,248,244,0.36);
}

.form-input:focus,
.form-textarea:focus {
  background: rgba(97,242,255,0.045);
  border-color: rgba(97,242,255,0.48);
  box-shadow: 0 0 0 3px rgba(97,242,255,0.08);
}

.form-textarea {
  min-height: 132px;
  resize: vertical;
}

.form-submit {
  width: 100%;
  margin-top: 8px;
}

footer {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 28px clamp(20px, 4vw, 56px);
  color: rgba(239,248,244,0.42);
  background: #05080a;
  border-top: 1px solid rgba(255,255,255,0.08);
}

.footer-text {
  font-size: 14px;
  letter-spacing: 0.7px;
}

.footer-links {
  display: flex;
  gap: 18px;
}

.footer-links a {
  color: rgba(239,248,244,0.48);
  text-decoration: none;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.footer-links a:hover,
.footer-links a:focus-visible {
  color: var(--mc-cyan);
}

.minimap {
  position: fixed;
  right: 22px;
  bottom: 22px;
  z-index: 850;
  width: 118px;
}

.minimap-wrap {
  padding: 10px;
  background: rgba(4,10,12,0.74);
  border: 1px solid rgba(97,242,255,0.19);
  box-shadow: 0 20px 70px rgba(0,0,0,0.36);
  backdrop-filter: blur(16px);
}

.minimap-title {
  margin-bottom: 8px;
  color: var(--mc-green);
  font-family: "Press Start 2P", monospace;
  font-size: 5px;
  letter-spacing: 1px;
  text-align: center;
}

.minimap-nav {
  display: grid;
  gap: 4px;
}

.minimap-dot {
  display: grid;
  grid-template-columns: 8px 1fr;
  gap: 6px;
  align-items: center;
  padding: 4px;
  transition: background 180ms var(--ease);
}

.minimap-dot:hover,
.minimap-dot.active {
  background: rgba(97,242,255,0.06);
}

.m-dot {
  width: 8px;
  height: 8px;
  background: rgba(255,255,255,0.18);
}

.m-label {
  color: rgba(239,248,244,0.46);
  font-family: "Press Start 2P", monospace;
  font-size: 4px;
  line-height: 1.4;
}

.minimap-dot.active .m-dot,
.minimap-dot:hover .m-dot {
  background: var(--mc-cyan);
  box-shadow: 0 0 10px var(--mc-cyan);
}

.minimap-dot.active .m-label,
.minimap-dot:hover .m-label {
  color: var(--mc-cyan);
}

.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 760ms var(--ease), transform 760ms var(--ease);
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

.glitch {
  position: relative;
}

.glitch::before,
.glitch::after {
  content: attr(data-text);
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
}

.glitch::before {
  color: var(--mc-cyan);
  transform: translate(2px, 0);
  clip-path: inset(0 0 56% 0);
}

.glitch::after {
  color: var(--mc-red);
  transform: translate(-2px, 0);
  clip-path: inset(52% 0 0 0);
}

.glitch.is-glitching::before,
.glitch.is-glitching::after {
  opacity: 0.5;
  animation: titleGlitch 420ms steps(2, end);
}

@keyframes titleGlitch {
  33% {
    transform: translate(7px, -2px);
  }
  66% {
    transform: translate(-7px, 2px);
  }
}

@media (max-width: 1100px) {
  .hero-content,
  .case-intro {
    grid-template-columns: 1fr;
  }

  .hud-panel {
    max-width: 460px;
  }

  .projects-grid,
  .lab-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .video-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 820px) {
  body {
    cursor: auto;
  }

  .cursor-sprite,
  .cursor-aura,
  .tooltip {
    display: none;
  }

  nav {
    padding: 14px 20px;
  }

  .nav-links,
  .nav-status,
  .minimap {
    display: none;
  }

  .nav-logo {
    font-size: 8px;
  }

  #hero {
    padding-top: 96px;
  }

  .hero-title {
    font-size: clamp(40px, 13vw, 72px);
  }

  .hero-actions {
    flex-direction: column;
  }

  .hero-btn,
  .resume-btn {
    width: 100%;
  }

  .hud-panel {
    width: 100%;
  }

  .about-grid,
  .contact-grid,
  .achievement-layout,
  .case-intro,
  .projects-grid,
  .lab-grid,
  .video-grid {
    grid-template-columns: 1fr;
  }

  .meta-grid {
    grid-template-columns: 1fr;
  }

  .craft-slot {
    min-height: 104px;
  }

  footer {
    flex-direction: column;
    text-align: center;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 1ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 1ms !important;
  }
}

/* ═══ ENHANCED STYLES ═══════════════════════════════════════════════════════ */

/* Green sparks section divider */
.sparks-divider {
  position: relative;
  width: 100%;
  height: 180px;
  overflow: hidden;
  margin: 0;
  z-index: 3;
}
.sparks-divider::before {
  content: "";
  position: absolute;
  inset: 0;
  background: url("data:image/png;base64,") center/cover no-repeat;
  opacity: 0.85;
}
.sparks-divider::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(5,8,10,0.95) 0%, transparent 40%, transparent 60%, rgba(5,8,10,0.95) 100%);
}

/* Real Minecraft inventory UI crafting wrap */
.crafting-wrap {
  border: 3px solid rgba(180,180,180,0.4) !important;
  box-shadow: inset 0 0 0 3px rgba(255,255,255,0.15), 0 30px 80px rgba(0,0,0,0.7) !important;
  padding: 28px !important;
  image-rendering: pixelated;
  position: relative;
}
.crafting-wrap::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.55);
  z-index: 0;
}
.crafting-wrap > * { position: relative; z-index: 1; }
.craft-slot {
  background: rgba(120,120,120,0.35) !important;
  border: 2px solid rgba(255,255,255,0.25) !important;
  box-shadow: inset 2px 2px 0 rgba(255,255,255,0.3), inset -2px -2px 0 rgba(0,0,0,0.5) !important;
  image-rendering: pixelated;
  transition: transform 220ms, box-shadow 220ms, border-color 220ms !important;
}
.craft-slot:hover {
  border-color: var(--mc-cyan) !important;
  box-shadow: 0 0 18px var(--mc-cyan), inset 2px 2px 0 rgba(255,255,255,0.3) !important;
  transform: scale(1.08) !important;
}

/* Valley hero glow ring */
.hero-valley-glow {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 35%;
  background: radial-gradient(ellipse at 50% 100%, rgba(120,224,107,0.35), transparent 70%);
  z-index: 2;
  pointer-events: none;
  animation: valleyPulse 4s ease-in-out infinite alternate;
}
@keyframes valleyPulse {
  to { opacity: 0.6; transform: scaleY(1.15); }
}

/* Pixel border on project cards */
.project-card {
  image-rendering: auto;
  border: 1px solid rgba(97,242,255,0.18) !important;
  transition: transform 280ms var(--ease), box-shadow 280ms var(--ease), border-color 280ms var(--ease) !important;
}
.project-card:hover {
  border-color: rgba(97,242,255,0.65) !important;
  box-shadow: 0 0 0 1px rgba(97,242,255,0.3), 0 24px 60px rgba(0,0,0,0.55), 0 0 40px rgba(97,242,255,0.12) !important;
}

/* Glowing section titles */
.section-title {
  text-shadow: 0 0 40px rgba(97,242,255,0.18), 0 2px 4px rgba(0,0,0,0.8) !important;
}

/* Green XP particles on achievements */
#achievements {
  background: url("data:image/png;base64,") center/cover no-repeat;
  background-attachment: fixed;
}
#achievements::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(5,8,10,0.88);
  z-index: 0;
}
#achievements .section-container { position: relative; z-index: 2; }

/* Enhanced HUD panel */
.hud-panel {
  border: 1px solid rgba(97,242,255,0.32) !important;
  box-shadow: 0 0 0 1px rgba(97,242,255,0.08), 0 30px 90px rgba(0,0,0,0.55), 0 0 60px rgba(97,242,255,0.06) !important;
}

/* Google Drive button */
.drive-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 12px 22px;
  background: rgba(66,133,244,0.1);
  border: 1px solid rgba(66,133,244,0.45);
  color: #7ab4ff;
  text-decoration: none;
  font-family: "Orbitron", sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  transition: all 220ms var(--ease);
  margin-top: 14px;
}
.drive-btn:hover {
  background: rgba(66,133,244,0.22);
  border-color: rgba(66,133,244,0.8);
  color: #fff;
  transform: translateY(-2px);
  box-shadow: 0 0 28px rgba(66,133,244,0.25);
}
.drive-btn svg { width: 18px; height: 18px; flex-shrink: 0; }

/* Enhanced filter buttons */
.filter-btn {
  border-radius: 0 !important;
  position: relative;
  overflow: hidden;
}
.filter-btn::after {
  content: "";
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  background: var(--mc-cyan);
  transform: scaleX(0);
  transition: transform 220ms var(--ease);
}
.filter-btn.active::after, .filter-btn:hover::after { transform: scaleX(1); }

/* Contact portal glow upgrade */
.portal-bg {
  border-width: 2px !important;
  box-shadow: 0 0 120px rgba(97,242,255,0.2), inset 0 0 80px rgba(120,224,107,0.1) !important;
}

/* Minecraft-style section kicker icon */
.section-kicker::before {
  content: "▶ ";
  color: var(--mc-green);
}

/* Loading cubes more vivid */
.loader-cubes span {
  background: linear-gradient(135deg, url("data:image/png;base64,"), #6fc45f, #234322) !important;
}

/* Footer upgrade */
footer {
  background: rgba(3,6,8,0.95) !important;
  border-top: 1px solid rgba(97,242,255,0.18) !important;
}


#about {
  background: linear-gradient(180deg, rgba(5,9,12,0.97) 0%, rgba(7,12,16,0.97) 100%), url("data:image/png;base64,") center 30%/cover no-repeat;
}

.project-type-label {
  font-family: "Press Start 2P", monospace !important;
  font-size: 6px !important;
}
.project-card .card-thumb {
  position: relative;
  overflow: hidden;
}
.project-card .card-thumb::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(4,9,12,0.95) 100%);
}

.skill-fill.animated {
  animation: skillPulse 2s ease-in-out infinite alternate;
}
@keyframes skillPulse {
  from { box-shadow: 0 0 10px var(--sc); }
  to   { box-shadow: 0 0 24px var(--sc), 0 0 6px rgba(255,255,255,0.3); }
}
